{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "host": {
      "projectType": "application",
      "root": "projects/host",
      "sourceRoot": "projects/host/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "projects/host/src/main.ts",
            "index": {
              "input": "projects/host/src/index.html",
              "preloadInitial": false
            },
            "tsConfig": "tsconfig.app.json",
            "styles": [
              "projects/host/src/styles.css"
            ],
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/host/public"
              }
            ],
            "externalDependencies": [
              "@platform/sdk"
            ]
          },
          "configurations": {
            "production": {
              "outputHashing": "none"
            },
            "development": {
              "optimization": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "host:build:production"
            },
            "development": {
              "buildTarget": "host:build:development"
            }
          },
          "defaultConfiguration": "development"
        }
      }
    },
    "mfe-orders": {
      "projectType": "application",
      "root": "projects/mfe-orders",
      "sourceRoot": "projects/mfe-orders/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "projects/mfe-orders/src/main.ts",
            "index": {
              "input": "projects/mfe-orders/src/index.html",
              "preloadInitial": false
            },
            "tsConfig": "tsconfig.app.json",
            "outputHashing": "none",
            "externalDependencies": [
              "@platform/sdk"
            ],
            "assets": [
              {
                "glob": "sdk.js",
                "input": "dist/platform-sdk",
                "output": "platform/sdk/1.0.0"
              }
            ]
          },
          "defaultConfiguration": "production",
          "configurations": {
            "production": {},
            "development": {
              "optimization": false,
              "sourceMap": true
            }
          }
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "port": 4201
          },
          "configurations": {
            "production": {
              "buildTarget": "mfe-orders:build:production"
            },
            "development": {
              "buildTarget": "mfe-orders:build:development"
            }
          },
          "defaultConfiguration": "development"
        }
      }
    },
    "mfe-profile": {
      "projectType": "application",
      "root": "projects/mfe-profile",
      "sourceRoot": "projects/mfe-profile/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "projects/mfe-profile/src/main.ts",
            "index": {
              "input": "projects/mfe-profile/src/index.html",
              "preloadInitial": false
            },
            "tsConfig": "tsconfig.app.json",
            "outputHashing": "none",
            "externalDependencies": [
              "@platform/sdk"
            ],
            "assets": [
              {
                "glob": "sdk.js",
                "input": "dist/platform-sdk",
                "output": "platform/sdk/1.0.0"
              }
            ]
          },
          "defaultConfiguration": "production",
          "configurations": {
            "production": {},
            "development": {
              "optimization": false,
              "sourceMap": true
            }
          }
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "port": 4202
          },
          "configurations": {
            "production": {
              "buildTarget": "mfe-profile:build:production"
            },
            "development": {
              "buildTarget": "mfe-profile:build:development"
            }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  }
}
